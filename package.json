{
  "name": "openlume",
  "productName": "OpenLume",
  "version": "0.2.0-beta.15",
  "description": "OpenLume: software livre de VJ e projeção mapeada, no jeito do Resolume",
  "license": "GPL-3.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tools/selftest.mjs",
    "dist": "electron-builder --win nsis --x64"
  },
  "author": "Felipe Spencer",
  "build": {
    "appId": "app.openlume",
    "productName": "OpenLume",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "lasercube.js",
      "app/**/*",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "extraResources": [
      {
        "from": "tools/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe"
        ]
      }
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "OpenLume",
      "additionalLightArgs": [
        "-sval"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "OpenLume",
      "language": "1046"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "mp4box": "^2.4.1",
    "onnxruntime-node": "^1.31.1",
    "onnxruntime-web": "^1.31.1",
    "selfsigned": "^2.4.1"
  }
}
